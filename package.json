{
  "name": "fairshift",
  "version": "0.1.0",
  "private": true,
  "description": "FairShift — anonymous, tamper-evident worker safety reporting with zero-knowledge membership proofs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "setup:zk": "node scripts/fetch-zk-artifacts.mjs",
    "seed:proofs": "tsx scripts/build-seed-proofs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@semaphore-protocol/core": "4.14.5",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
