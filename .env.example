# --- Required in production (set these in Cloud Run, never commit them) ---
FAIRSHIFT_ADMIN_PASSPHRASE=change-me
FAIRSHIFT_OVERSIGHT_PASSPHRASE=change-me-separately
FAIRSHIFT_SESSION_SECRET=generate-a-long-random-string
# 32 random bytes, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
FAIRSHIFT_SEAL_KEY=
# Ed25519 seeds, base64 (optional: generated into the data dir on first boot)
FAIRSHIFT_SYSTEM_SEED=
FAIRSHIFT_ADMIN_SEED=
FAIRSHIFT_OVERSIGHT_SEED=

# --- Runtime ---
FAIRSHIFT_DATA_DIR=/tmp/fairshift
NEXT_PUBLIC_DEMO_MODE=true
